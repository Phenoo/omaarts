rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() &&
        (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'staff' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_Admin');
    }

    function isImageUpload() {
      return request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    function isPublicResource() {
      return resource != null &&
        !resource.name.matches('.*/(private|unpublished)/.*') &&
        resource.metadata.get('visibility', 'public') == 'public';
    }

    // Public website assets can be displayed without a Firebase login.
    match /artworks/{allPaths=**} {
      // Existing artwork-temp files are still referenced by published records;
      // remove those objects after updating their records, then delete this
      // compatibility exception.
      allow read: if isPublicResource();
      allow create, update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    match /activities/{allPaths=**} {
      allow read: if isPublicResource();
      allow create, update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    match /gallery/{allPaths=**} {
      allow read: if isPublicResource();
      allow create, update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    match /site/{allPaths=**} {
      allow read: if isPublicResource();
      allow create, update: if isStaff() && isImageUpload();
      allow delete: if isStaff();
    }

    // Everything else stays private until a specific, reviewed upload use case exists.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
