rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for user authorization
    function userDocExists() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return userDocExists() && 
        (getUserData().role == 'admin' || getUserData().role == 'super_admin' || getUserData().role == 'super_Admin');
    }
    
    function isStaff() {
      return userDocExists() && 
        (getUserData().role == 'admin' || getUserData().role == 'super_admin' || getUserData().role == 'super_Admin' || getUserData().role == 'staff');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Wishlist subcollection — only the owning user can read/write
      match /wishlist/{artworkId} {
        allow read, write: if isOwner(userId);
      }

      // Cart subcollection — only the owning user can read/write
      match /cart/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Activities collection rules
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Artworks collection rules
    match /artworks/{artworkId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Materials and other shop goods
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Categories collection rules
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Bookings collection rules
    match /bookings/{bookingId} {
      // Checkout records are created by the server. Customers read only their own records;
      // guest receipts are served through the server-side payment status endpoint.
      allow read: if isStaff() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if isStaff();
      allow update, delete: if isStaff();
    }

    // Orders collection rules
    match /orders/{orderId} {
      // Checkout records are created by the server. Customers read only their own records;
      // guest receipts are served through the server-side payment status endpoint.
      allow read: if isStaff() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if isStaff();
      allow update, delete: if isStaff();
    }

    // Payments collection rules
    match /payments/{paymentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Sales ledger rules
    match /sales/{saleId} {
      allow read, write: if isStaff();
    }

    // Blocked Dates rules
    match /blockedDates/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Enquiries collection rules
    match /enquiries/{enquiryId} {
      allow read: if isStaff();
      allow create: if true; // anyone can send contact/event enquiries
      allow update, delete: if isStaff();
    }

    // Testimonials collection rules
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Gallery collection rules
    match /gallery/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Site settings collection rules
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Inventory movements log rules
    match /inventoryMovements/{movementId} {
      allow read, write: if isStaff();
    }

    // Activity Price changes rules
    match /activityPriceHistory/{historyId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Security Audit logs rules
    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }
  }
}
